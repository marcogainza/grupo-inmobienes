# Base de datos (Vercel Postgres). Si conectaste el proyecto a una base
# Vercel Postgres/Neon, estas dos ya existen automáticamente en Vercel
# (Storage > tu base > Quickstart). Para desarrollo local, cópialas desde ahí.
DATABASE_URL="postgres://usuario:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgres://usuario:password@host/db?sslmode=require"

# Vercel Blob (fotos de entregas, testimonios y blog). En producción, si el
# proyecto está conectado a la tienda Blob, no hace falta configurarla (usa
# autenticación OIDC automática). Solo se necesita para correr en local.
BLOB_READ_WRITE_TOKEN=""

# Secreto usado para firmar la cookie de sesión del admin. Genera uno único con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Credenciales del usuario admin, solo se usan al ejecutar el seed inicial
# (npm run db:seed). Después de la primera vez, cambia la clave desde /admin.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"
