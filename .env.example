# Base de datos (Vercel Postgres). Copia los valores exactos desde
# Vercel > tu proyecto > Storage > tu base de datos > pestaña ".env.local"
DATABASE_URL="postgres://usuario:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://usuario:password@host/db?sslmode=require"

# Vercel Blob (fotos de entregas, testimonios y blog)
BLOB_READ_WRITE_TOKEN=""

# Secreto usado para firmar la cookie de sesión del admin. Genera uno único con:
# openssl rand -base64 32
AUTH_SECRET=""

# Credenciales del usuario admin, solo se usan al ejecutar el seed inicial
# (npm run db:seed). Después de la primera vez, cambia la clave desde /admin.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"
